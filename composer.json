{
  "name": "islamic-network/sdk",
  "description": "Typed PHP SDK for Islamic Network APIs",
  "type": "library",
  "license": "LGPL-3.0-or-later",
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "cuyz/valinor": "^2",
    "illuminate/http": "^13",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^12"
  },
  "autoload": {
    "psr-4": {
      "IslamicNetwork\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IslamicNetwork\\Tests\\": "tests/"
    }
  }
}
